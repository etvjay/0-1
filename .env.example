DELPHI_NETWORK=competition-testnet
DELPHI_API_ACCESS_KEY=
# Optional: omit to use the active competition
DELPHI_COMPETITION_ID=

# Signing: configure exactly one supported Delphi signer in your local .env.
# Private-key example:
# DELPHI_SIGNER_TYPE=private_key
# WALLET_PRIVATE_KEY=0x...

# M0 trade-evaluation policy
ZERO_ONE_MIN_CONFIDENCE=0.60
ZERO_ONE_MIN_EXECUTION_EDGE=0.03
ZERO_ONE_MAX_QUOTE_AGE_MS=5000
ZERO_ONE_MAX_BELIEF_AGE_MS=300000
ZERO_ONE_MAX_POSITION_FRACTION=0.20
ZERO_ONE_MAX_PRICE_IMPACT=0.08
ZERO_ONE_QUOTE_SIZES=0.1,0.25,0.5,0.75,1

# Evidence and execution logs
ZERO_ONE_FORECAST_LOG=data/forecasts.jsonl
ZERO_ONE_TRADE_LOG=data/trades.jsonl

# General research adapters
TAVILY_API_KEY=
OPENAI_API_KEY=
ZERO_ONE_RESEARCH_MODEL=gpt-5.6

# Autonomous opportunity hunter
ZERO_ONE_HUNT_MARKET_LIMIT=100
ZERO_ONE_HUNT_RESEARCH_BUDGET=8
ZERO_ONE_HUNT_ACCOUNT_VALUE=100
ZERO_ONE_HUNT_MARKET_EXPOSURE=0
ZERO_ONE_HUNT_MAX_PRIOR_DRIFT=0.08

# Live execution. Keep false until the registered competition wallet is configured and funded.
ZERO_ONE_LIVE_TRADING=false
ZERO_ONE_KILL_SWITCH=false
ZERO_ONE_MAX_ORDER_TST=5
ZERO_ONE_MAX_CYCLE_TST=20
ZERO_ONE_SLIPPAGE_BPS=200
ZERO_ONE_MARKET_COOLDOWN_MS=1800000

# Persistent at-least-once runtime
ZERO_ONE_CYCLE_INTERVAL_MS=180000
ZERO_ONE_FAILURE_BACKOFF_MS=30000
ZERO_ONE_PENDING_RETRY_MS=30000
ZERO_ONE_TRADE_RETENTION_MS=86400000
ZERO_ONE_RUNTIME_STATE=data/runtime/runtime-state.json
ZERO_ONE_RUNTIME_LOCK=data/runtime/compete.lock
