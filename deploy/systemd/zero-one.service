[Unit]
Description=0-1 Delphi competition agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zero-one
Group=zero-one
WorkingDirectory=/opt/zero-one
EnvironmentFile=/opt/zero-one/.env
ExecStart=/usr/bin/npm run compete:loop
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zero-one/data

[Install]
WantedBy=multi-user.target
